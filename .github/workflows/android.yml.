
name: Build OpenCheps APK

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Extract project
        run: |
          unzip -q opencheps-main.zip
          cp -a opencheps-main/. .

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: android-actions/setup-android@v3
      - uses: gradle/actions/setup-gradle@v3

      - name: Prepare Gradle
        run: |
          gradle wrapper --gradle-version 8.7 --distribution-type bin
          chmod +x gradlew

      - name: Download Stockfish
        run: |
          set -e
          mkdir -p sf-cache
          curl -fL -o sf-cache/arm64.tar \
            https://github.com/official-stockfish/Stockfish/releases/download/sf_18/stockfish-android-armv8.tar
          curl -fL -o sf-cache/armv7.tar \
            https://github.com/official-stockfish/Stockfish/releases/download/sf_18/stockfish-android-armv7-neon.tar
          cd sf-cache
          tar xf arm64.tar
          tar xf armv7.tar
          mv stockfish/stockfish-android-armv8 libstockfish-arm64.so
          mv stockfish/stockfish-android-armv7-neon libstockfish-armv7.so
          cd ..
          mkdir -p app/src/main/jniLibs/arm64-v8a app/src/main/jniLibs/armeabi-v7a
          cp sf-cache/libstockfish-arm64.so app/src/main/jniLibs/arm64-v8a/libstockfish.so
          cp sf-cache/libstockfish-armv7.so app/src/main/jniLibs/armeabi-v7a/libstockfish.so

      - name: Build APK
        run: ./gradlew :app:assembleDebug --no-daemon

      - uses: actions/upload-artifact@v4
        with:
          name: opencheps-apk
          path: app/build/outputs/apk/**/*.apk
          if-no-files-found: error
